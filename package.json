{
    "name": "brownbook",
    "version": "1.0.0",
    "description": "A gamified task app with real-world rewards",
    "main": "main.cjs",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "preview": "electron . --preview",
        "build": "electron-builder --mac",
        "pack": "electron-builder --dir",
        "test": "node --test test/*.test.mjs plugins/brownbook-coast/test/*.test.mjs",
        "verify": "npm test && npm run pack"
    },
    "author": "BrownBook",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "devDependencies": {
        "electron": "^44.5.1",
        "electron-builder": "26.15.3",
        "motion": "^14.0.0"
    },
    "build": {
        "appId": "com.brownbook.app",
        "productName": "BrownBook",
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "icon-512.png",
            "target": [
                "dir"
            ]
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.cjs",
            "index.html",
            "styles.css",
            "notebook.css",
            "app.js",
            "data-model.js",
            "preview-data.js",
            "firebase-config.js",
            "manifest.json",
            "icon-192.png",
            "icon-512.png",
            "assets/**/*"
        ]
    },
    "dependencies": {
        "lucide": "^1.52.0"
    }
}
